<Project Sdk="Microsoft.NET.Sdk">

  <!-- Модульные тесты слоя представления (модели представления MVVM).
       Окна не создаются: проверяется логика экранов без запуска интерфейса. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Тестовые двойники хранилищ и часов берутся из Parking.Core.Tests, чтобы не дублировать код -->
    <Compile Include="..\Parking.Core.Tests\Fakes\FakeCategoryRepository.cs" Link="Fakes\FakeCategoryRepository.cs" />
    <Compile Include="..\Parking.Core.Tests\Fakes\FakeSessionRepository.cs" Link="Fakes\FakeSessionRepository.cs" />
    <Compile Include="..\Parking.Core.Tests\Fakes\ManualTimeProvider.cs" Link="Fakes\ManualTimeProvider.cs" />
    <Compile Include="..\Parking.Core.Tests\Fakes\FakeTariffRepository.cs" Link="Fakes\FakeTariffRepository.cs" />
    <Compile Include="..\Parking.Core.Tests\Fakes\FakeBookingRepository.cs" Link="Fakes\FakeBookingRepository.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Parking.Core\Parking.Core.csproj" />
    <ProjectReference Include="..\..\src\ParkingManager\ParkingManager.csproj" />
  </ItemGroup>

</Project>
