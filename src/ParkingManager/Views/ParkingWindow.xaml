<Window x:Class="ParkingManager.Views.ParkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ParkingManager.Converters"
        Title="ParkingManager — учёт парковки"
        Width="1100"
        Height="760"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <converters:CellStateToBrushConverter x:Key="CellStateToBrush" />
  </Window.Resources>
  <DockPanel Margin="16">
    <!-- Строка состояния парковки -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Оператор: " FontWeight="SemiBold" />
      <TextBlock AutomationProperties.AutomationId="OperatorNameText" Text="{Binding OperatorName}" Margin="0,0,24,0" />
      <TextBlock Text="Свободно обычных: " />
      <TextBlock AutomationProperties.AutomationId="RegularFreeText" Text="{Binding RegularFree}" FontWeight="SemiBold" Margin="0,0,16,0" />
      <TextBlock Text="Свободно для инвалидов: " />
      <TextBlock AutomationProperties.AutomationId="DisabledFreeText" Text="{Binding DisabledFree}" FontWeight="SemiBold" Margin="0,0,16,0" />
      <TextBlock Text="На парковке: " />
      <TextBlock AutomationProperties.AutomationId="ActiveCountText" Text="{Binding ActiveCount}" FontWeight="SemiBold" Margin="0,0,16,0" />
      <TextBlock Text="Брони: " />
      <TextBlock AutomationProperties.AutomationId="BookedCountText" Text="{Binding BookedCount}" FontWeight="SemiBold" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="StatusMessageText" Text="{Binding StatusMessage}" Foreground="DimGray" Margin="0,12,0,0" />

    <TabControl AutomationProperties.AutomationId="MainTabs">
      <!-- Вкладка «Стоянки»: вместимость, въезд, автомобили на парковке, выезд -->
      <TabItem Header="Стоянки" AutomationProperties.AutomationId="SessionsTab">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <ItemsControl Grid.Row="0" ItemsSource="{Binding Occupancy}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="320" Margin="0,0,12,12" Padding="12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" Foreground="Gray" />
                    <TextBlock FontSize="22" FontWeight="SemiBold">
                      <Run Text="{Binding Free, Mode=OneWay}" />
                      <Run Text="свободно из" FontSize="13" FontWeight="Normal" />
                      <Run Text="{Binding Capacity, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                    </TextBlock>
                    <ProgressBar Height="6" Margin="0,6,0,0" Maximum="{Binding Capacity, Mode=OneWay}" Value="{Binding Occupied, Mode=OneWay}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <Border Grid.Row="1" Padding="12" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Номер автомобиля:" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox AutomationProperties.AutomationId="CarNumberBox" Width="160" Padding="4" VerticalAlignment="Center"
                       Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}" />
              <RadioButton AutomationProperties.AutomationId="RegularCategoryRadio" Content="Обычное место" GroupName="EntryCategory"
                           IsChecked="{Binding IsRegularCategory}" VerticalAlignment="Center" Margin="16,0,0,0" />
              <RadioButton AutomationProperties.AutomationId="DisabledCategoryRadio" Content="Место для инвалидов" GroupName="EntryCategory"
                           IsChecked="{Binding IsDisabledCategory}" VerticalAlignment="Center" Margin="12,0,0,0" />
              <Button AutomationProperties.AutomationId="EntryButton" Content="Зарегистрировать въезд" Command="{Binding RegisterEntryCommand}"
                      Padding="12,6" Margin="16,0,0,0" />
            </StackPanel>
          </Border>

          <DockPanel Grid.Row="2" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Автомобили на парковке" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right" AutomationProperties.AutomationId="ExitButton" Content="Зарегистрировать выезд"
                    Command="{Binding RegisterExitCommand}" Padding="12,6" Margin="12,0,0,0" />
            <TextBox DockPanel.Dock="Right" AutomationProperties.AutomationId="SearchBox" Width="200" Padding="4" VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock DockPanel.Dock="Right" Text="Поиск по номеру:" VerticalAlignment="Center" Margin="0,0,8,0" />
          </DockPanel>

          <DataGrid Grid.Row="3" AutomationProperties.AutomationId="SessionsGrid" ItemsSource="{Binding Sessions}"
                    SelectedItem="{Binding SelectedSession}" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Номер" Binding="{Binding CarNumber}" Width="160" />
              <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="160" />
              <DataGridTextColumn Header="Въезд" Binding="{Binding EntryTimeText}" Width="160" />
              <DataGridTextColumn Header="На парковке" Binding="{Binding DurationText}" Width="160" />
              <DataGridTextColumn Header="К оплате" Binding="{Binding AmountText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </TabItem>

      <!-- Вкладка «Брони»: брони на сегодня, правило неявки 15 минут -->
      <TabItem Header="Брони" AutomationProperties.AutomationId="BookingsTab">
        <DockPanel Margin="12" DataContext="{Binding Bookings}">
          <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Номер:" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox AutomationProperties.AutomationId="BookingCarNumberBox" Width="140" Padding="4" VerticalAlignment="Center"
                       Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}" />
              <RadioButton Content="Обычное" GroupName="BookingCategory" IsChecked="{Binding IsRegularCategory}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
              <RadioButton AutomationProperties.AutomationId="BookingDisabledRadio" Content="Для инвалидов" GroupName="BookingCategory"
                           IsChecked="{Binding IsDisabledCategory}" VerticalAlignment="Center" Margin="8,0,0,0" />
              <TextBlock Text="Прибытие (ЧЧ:ММ):" VerticalAlignment="Center" Margin="16,0,8,0" />
              <TextBox AutomationProperties.AutomationId="BookingTimeBox" Width="70" Padding="4" VerticalAlignment="Center"
                       Text="{Binding ArrivalText, UpdateSourceTrigger=PropertyChanged}" />
              <Button AutomationProperties.AutomationId="CreateBookingButton" Content="Забронировать" Command="{Binding CreateCommand}"
                      Padding="12,6" Margin="16,0,0,0" />
              <Button AutomationProperties.AutomationId="CancelBookingButton" Content="Отменить бронь" Command="{Binding CancelCommand}"
                      Padding="12,6" Margin="8,0,0,0" />
            </StackPanel>
          </Border>
          <TextBlock DockPanel.Dock="Top" AutomationProperties.AutomationId="BookingMessageText" Text="{Binding Message}"
                     FontWeight="SemiBold" Margin="0,0,0,8" />
          <TextBlock DockPanel.Dock="Bottom" Foreground="Gray" Margin="0,8,0,0"
                     Text="Бронь удерживает одно место категории. Если автомобиль не приехал в течение 15 минут после назначенного времени, бронь снимается автоматически." TextWrapping="Wrap" />
          <DataGrid AutomationProperties.AutomationId="BookingsGrid" ItemsSource="{Binding Bookings}" SelectedItem="{Binding SelectedBooking}"
                    AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Номер" Binding="{Binding CarNumber}" Width="140" />
              <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="140" />
              <DataGridTextColumn Header="Прибытие" Binding="{Binding ArrivalText}" Width="100" />
              <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Вкладка «Схема занятости»: квадратик = место, заполнение по порядку -->
      <TabItem Header="Схема занятости" AutomationProperties.AutomationId="SchemeTab">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12">
            <ItemsControl ItemsSource="{Binding Occupancy}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Summary}" Foreground="Gray" Margin="0,2,0,8" />
                    <ItemsControl ItemsSource="{Binding Cells}" HorizontalAlignment="Left">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <UniformGrid Columns="{Binding CellColumns}" />
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Rectangle Width="14" Height="14" Margin="1.5" RadiusX="2" RadiusY="2"
                                     Fill="{Binding Converter={StaticResource CellStateToBrush}}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal">
              <Rectangle Width="14" Height="14" Fill="IndianRed" RadiusX="2" RadiusY="2" />
              <TextBlock Text="занято" Margin="6,0,20,0" />
              <Rectangle Width="14" Height="14" Fill="Orange" RadiusX="2" RadiusY="2" />
              <TextBlock Text="забронировано" Margin="6,0,20,0" />
              <Rectangle Width="14" Height="14" Fill="LightGreen" RadiusX="2" RadiusY="2" />
              <TextBlock Text="свободно" Margin="6,0,20,0" />
            </StackPanel>
            <TextBlock Text="Места не привязаны к автомобилям: схема показывает только количество занятых и свободных мест."
                       Foreground="Gray" Margin="0,8,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Вкладка «История»: стоянки за период -->
      <TabItem Header="История" AutomationProperties.AutomationId="HistoryTab">
        <DockPanel Margin="12" DataContext="{Binding History}">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker AutomationProperties.AutomationId="HistoryFromPicker" SelectedDate="{Binding From}" Width="130" />
            <TextBlock Text="по" VerticalAlignment="Center" Margin="12,0,6,0" />
            <DatePicker AutomationProperties.AutomationId="HistoryToPicker" SelectedDate="{Binding To}" Width="130" />
            <TextBlock Text="Номер:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <TextBox AutomationProperties.AutomationId="HistorySearchBox" Width="160" Padding="4" VerticalAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <Button AutomationProperties.AutomationId="ShowHistoryButton" Content="Показать" Command="{Binding ShowCommand}"
                    Padding="12,4" Margin="12,0,0,0" />
          </StackPanel>
          <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="HistorySummaryText" Text="{Binding Summary}"
                     FontWeight="SemiBold" Margin="0,8,0,0" />
          <DataGrid AutomationProperties.AutomationId="HistoryGrid" ItemsSource="{Binding Sessions}" AutoGenerateColumns="False"
                    IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Номер" Binding="{Binding CarNumber}" Width="140" />
              <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="140" />
              <DataGridTextColumn Header="Въезд" Binding="{Binding EntryTimeText}" Width="150" />
              <DataGridTextColumn Header="Выезд" Binding="{Binding ExitTimeText}" Width="150" />
              <DataGridTextColumn Header="Время" Binding="{Binding DurationText}" Width="120" />
              <DataGridTextColumn Header="Сумма" Binding="{Binding AmountText}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>

      <!-- Вкладка «Отчёты»: статистика за период, выгрузка в Excel и PDF -->
      <TabItem Header="Отчёты" AutomationProperties.AutomationId="ReportsTab">
        <DockPanel Margin="12" DataContext="{Binding Reports}">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="С" VerticalAlignment="Center" Margin="0,0,6,0" />
            <DatePicker AutomationProperties.AutomationId="ReportFromPicker" SelectedDate="{Binding From}" Width="130" />
            <TextBlock Text="по" VerticalAlignment="Center" Margin="12,0,6,0" />
            <DatePicker AutomationProperties.AutomationId="ReportToPicker" SelectedDate="{Binding To}" Width="130" />
            <Button AutomationProperties.AutomationId="BuildReportButton" Content="Сформировать" Command="{Binding BuildCommand}"
                    Padding="12,4" Margin="12,0,0,0" />
            <Button AutomationProperties.AutomationId="ExportExcelButton" Content="Сохранить в Excel" Command="{Binding ExportExcelCommand}"
                    Padding="12,4" Margin="24,0,0,0" />
            <Button AutomationProperties.AutomationId="ExportPdfButton" Content="Сохранить в PDF" Command="{Binding ExportPdfCommand}"
                    Padding="12,4" Margin="8,0,0,0" />
          </StackPanel>

          <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,12" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="6">
            <StackPanel>
              <TextBlock AutomationProperties.AutomationId="ReportTotalsText" Text="{Binding TotalsText}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock AutomationProperties.AutomationId="ReportBookingsText" Text="{Binding BookingsText}" Foreground="Gray" Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="ReportMessageText" Text="{Binding Message}"
                     FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" />
              <ColumnDefinition Width="16" />
              <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="По категориям мест" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DataGrid Grid.Row="1" Grid.Column="0" AutomationProperties.AutomationId="ReportCategoriesGrid" ItemsSource="{Binding Categories}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False" VerticalAlignment="Top">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Категория" Binding="{Binding CategoryName}" Width="*" />
                <DataGridTextColumn Header="Стоянок" Binding="{Binding Sessions}" Width="80" />
                <DataGridTextColumn Header="Завершено" Binding="{Binding Finished}" Width="90" />
                <DataGridTextColumn Header="Выручка" Binding="{Binding RevenueText}" Width="100" />
                <DataGridTextColumn Header="Ср. стоянка" Binding="{Binding AverageStayText}" Width="110" />
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="0" Grid.Column="2" Text="По дням" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6" />
            <DataGrid Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="ReportDaysGrid" ItemsSource="{Binding Days}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding DateText}" Width="*" />
                <DataGridTextColumn Header="Въездов" Binding="{Binding Entries}" Width="80" />
                <DataGridTextColumn Header="Выручка" Binding="{Binding RevenueText}" Width="100" />
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </DockPanel>
      </TabItem>

      <!-- Вкладка «Тарифы и места»: вместимость категорий и стоимость часа -->
      <TabItem Header="Тарифы и места" AutomationProperties.AutomationId="SettingsTab">
        <StackPanel Margin="12" DataContext="{Binding Settings}" HorizontalAlignment="Left">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="220" />
              <ColumnDefinition Width="140" />
              <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Категория мест" Foreground="Gray" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Мест" Foreground="Gray" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Стоимость часа, ₽" Foreground="Gray" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Обычные места" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="1" Grid.Column="1" AutomationProperties.AutomationId="RegularCapacityBox" Width="100" Padding="4"
                     HorizontalAlignment="Left" Margin="0,8,0,0" Text="{Binding RegularCapacityText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="1" Grid.Column="2" AutomationProperties.AutomationId="RegularPriceBox" Width="100" Padding="4"
                     HorizontalAlignment="Left" Margin="0,8,0,0" Text="{Binding RegularPriceText, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Места для инвалидов" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox Grid.Row="2" Grid.Column="1" AutomationProperties.AutomationId="DisabledCapacityBox" Width="100" Padding="4"
                     HorizontalAlignment="Left" Margin="0,8,0,0" Text="{Binding DisabledCapacityText, UpdateSourceTrigger=PropertyChanged}" />
            <TextBox Grid.Row="2" Grid.Column="2" AutomationProperties.AutomationId="DisabledPriceBox" Width="100" Padding="4"
                     HorizontalAlignment="Left" Margin="0,8,0,0" Text="{Binding DisabledPriceText, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
          <TextBlock Text="{Binding InUseText}" Foreground="Gray" Margin="0,12,0,0" />
          <TextBlock Text="Оплачивается каждый начатый час стоянки. Мест для инвалидов — не менее 10 % от общего числа."
                     Foreground="Gray" Margin="0,4,0,0" />
          <Button AutomationProperties.AutomationId="SaveSettingsButton" Content="Сохранить" Command="{Binding SaveCommand}"
                  HorizontalAlignment="Left" Padding="16,6" Margin="0,12,0,0" />
          <TextBlock AutomationProperties.AutomationId="SettingsMessageText" Text="{Binding Message}" FontWeight="SemiBold" Margin="0,8,0,0" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
