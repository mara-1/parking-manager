<Window x:Class="ParkingManager.Views.ParkingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ParkingManager.Converters"
        Title="ParkingManager — схема парковки"
        Width="920"
        Height="560"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <converters:SpotStatusToBrushConverter x:Key="SpotStatusToBrush" />
  </Window.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock Text="Оператор: " FontWeight="SemiBold" />
      <TextBlock AutomationProperties.AutomationId="OperatorNameText" Text="{Binding OperatorName}" Margin="0,0,24,0" />
      <TextBlock Text="Свободно: " />
      <TextBlock AutomationProperties.AutomationId="FreeCountText" Text="{Binding FreeCount}" FontWeight="SemiBold" Margin="0,0,16,0" />
      <TextBlock Text="Занято: " />
      <TextBlock AutomationProperties.AutomationId="OccupiedCountText" Text="{Binding OccupiedCount}" FontWeight="SemiBold" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom" AutomationProperties.AutomationId="StatusMessageText" Text="{Binding StatusMessage}" Foreground="DimGray" Margin="0,12,0,0" />

    <StackPanel DockPanel.Dock="Right" Width="240" Margin="16,0,0,0">
      <TextBlock Text="Выбранное место" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
      <TextBlock AutomationProperties.AutomationId="SelectedSpotNumberText" Text="{Binding SelectedSpot.Number, FallbackValue=не выбрано}" FontSize="22" />
      <TextBlock AutomationProperties.AutomationId="SelectedSpotStatusText" Text="{Binding SelectedSpot.StatusText}" Foreground="Gray" Margin="0,0,0,16" />

      <TextBlock Text="Номер автомобиля" />
      <TextBox AutomationProperties.AutomationId="CarNumberBox" Text="{Binding CarNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="4" />

      <Button AutomationProperties.AutomationId="EntryButton" Content="Зарегистрировать въезд" Command="{Binding RegisterEntryCommand}" Padding="8,6" Margin="0,0,0,8" />
      <Button AutomationProperties.AutomationId="ExitButton" Content="Зарегистрировать выезд" Command="{Binding RegisterExitCommand}" Padding="8,6" />
    </StackPanel>

    <ListBox AutomationProperties.AutomationId="SpotsList"
             ItemsSource="{Binding Spots}"
             SelectedItem="{Binding SelectedSpot}"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <!-- Идентификатор каждого места (Spot_A-01 и т. д.) нужен UI-тестам -->
      <ListBox.ItemContainerStyle>
        <Style TargetType="ListBoxItem">
          <Setter Property="AutomationProperties.AutomationId" Value="{Binding Number, StringFormat='Spot_{0}'}" />
          <Setter Property="AutomationProperties.Name" Value="{Binding Number}" />
          <Setter Property="AutomationProperties.HelpText" Value="{Binding Details}" />
        </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemsPanel>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </ListBox.ItemsPanel>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <Border Width="110" Height="70" Margin="4" CornerRadius="4"
                  Background="{Binding Status, Converter={StaticResource SpotStatusToBrush}}">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Number}" FontWeight="SemiBold" HorizontalAlignment="Center" />
              <TextBlock Text="{Binding Details}" FontSize="11" TextAlignment="Center" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
